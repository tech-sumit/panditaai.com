{
  "name": "panditaai-contact",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create panditaai-contacts",
    "db:migrate": "wrangler d1 execute panditaai-contacts --file=./schema.sql",
